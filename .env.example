# ==============================================================================
# Variables de Entorno de Ejemplo para la API de Citas (Spring Boot)
# Copia este archivo a '.env' y completa los valores con tus credenciales reales
# ==============================================================================

# Conexión a la Base de Datos PostgreSQL
# Ejemplo local: jdbc:postgresql://localhost:5432/citas_db
# Ejemplo nube (Neon/Render/Supabase): jdbc:postgresql://<host>:<puerto>/<nombre_bd>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/citas_db
DB_USERNAME=tu_usuario_de_bd
DB_PASSWORD=tu_contrasenia_segura

# Puerto en el que se ejecutará el servidor (por defecto: 8080)
PORT=8080
